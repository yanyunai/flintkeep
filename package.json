{
  "name": "flintkeep",
  "productName": "FlintKeep",
  "version": "0.1.0",
  "description": "燧垒（FlintKeep）——本地加密的基础设施凭证与资产保险库：Agent 通过 MCP 使用密钥，但永远看不到密钥。",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "core:test": "tsx src/core/test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "tsx src/core/test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"electron/**/*.mjs\" \"server.ts\" \"scripts/**/*.mjs\"",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:stat": "node scripts/check-i18n.mjs --stat",
    "mcp": "tsx src/core/mcp.ts",
    "fk": "tsx src/core/cli.ts",
    "mcp:baseline": "node scripts/mcp_baseline.mjs",
    "server": "tsx server.ts",
    "dev:ui": "vite",
    "dev:server": "tsx server.ts",
    "dev": "concurrently -k -n ui,api \"vite\" \"tsx server.ts\"",
    "build": "vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis --x64",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:dev": "concurrently -k -n ui,app \"vite\" \"wait-on tcp:8790 && cross-env VITE_DEV=1 node scripts/start-desktop.mjs\"",
    "dev:electron": "npm run desktop:dev",
    "start:electron": "npm run build && node scripts/start-desktop.mjs",
    "smoke:http": "tsx scripts/http-smoke.mjs",
    "smoke:server": "tsx scripts/smoke_server.mjs",
    "smoke:projects": "tsx scripts/smoke_projects.mjs",
    "smoke:whitelist": "tsx scripts/smoke_whitelist.mjs",
    "whitelist:run": "tsx scripts/whitelist_run.ts",
    "smoke:memo": "tsx scripts/smoke_memo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@volcengine/ark-cli": "^1.0.43",
    "bailian-cli": "^2.7.2",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tencent-tokenhub-cli": "^1.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.85",
    "ai": "^7.0.163",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.yanyun.flintkeep",
    "productName": "FlintKeep",
    "copyright": "Copyright © 2026 yanyun",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/app-icon.png",
      "artifactName": "FlintKeep-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlintKeep 燧垒",
      "deleteAppDataOnUninstall": false
    }
  }
}
